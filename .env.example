# Optional but required for automatic live web discovery.
# Get a key from Tavily, then set it in local .env or your hosting provider.
TAVILY_API_KEY=

# Frontend development origin(s). Production is served from the same backend origin.
CORS_ORIGINS=http://localhost:5173

# MCP Python SDK DNS-rebinding allowlists are normally inferred by your deployment.
# When using an ngrok tunnel, follow the README and set MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS if needed.
MCP_HOST=0.0.0.0
